# Bridge production configuration template
#
# Copy these names into your hosting providers' environment/secret settings.
# Do not commit populated production values. Values in angle brackets are placeholders.

NODE_ENV=production

# Static frontend build configuration (public; embedded in browser assets)
BRIDGE_FRONTEND_ORIGIN=https://<frontend-host>
VITE_SIGNALING_URL=wss://<signaling-host>/signal

# Signaling runtime admission policy
SIGNAL_ALLOWED_ORIGINS=https://<frontend-host>

# Preferred production TURN mode: durable shared secret stays server-side.
SIGNAL_TURN_URLS=turns:<turn-host>:5349?transport=tcp,turn:<turn-host>:3478?transport=udp
SIGNAL_TURN_SHARED_SECRET=<store-in-server-secret-manager>
SIGNAL_TURN_CREDENTIAL_TTL_SECONDS=900

# Optional server-only metrics protection. Leave unset when the trusted platform
# already authenticates/private-routes metrics; never expose this through VITE_*.
# SIGNAL_METRICS_BEARER_TOKEN=<store-in-server-secret-manager>

# Optional runtime tuning; defaults are intentionally conservative.
# PORT=8787
# SESSION_TTL_MS=600000
# SESSION_CLEANUP_INTERVAL_MS=30000
# SIGNAL_ATTACH_TIMEOUT_MS=30000
# SIGNAL_HEARTBEAT_INTERVAL_MS=30000
# SIGNAL_SHUTDOWN_GRACE_MS=5000
# MAX_SIGNAL_MESSAGE_BYTES=262144
# MAX_SIGNAL_SESSIONS=10000
# MAX_SIGNAL_CONNECTIONS=20000
# SIGNAL_MESSAGES_PER_MINUTE=120
# SIGNAL_CREATES_PER_10_MINUTES=20
# SIGNAL_JOINS_PER_10_MINUTES=60

# Do not configure VITE_BRIDGE_TURN_USERNAME or VITE_BRIDGE_TURN_CREDENTIAL
# when using the preferred server-managed SIGNAL_TURN_* mode above.
